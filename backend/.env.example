# Copy to .env and replace values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=esims_app
DB_PASSWORD=replace-me
DB_NAME=esims_db
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 behind HTTPS in deployment.

# Cloud database (TiDB Cloud): use port 4000 and set the certificate path.
# DB_SSL_CA=certs/ca.pem
